{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "python",
  "include-component-in-tag": false,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance Improvements"
    },
    {
      "type": "revert",
      "section": "Reverts"
    },
    {
      "type": "build",
      "section": "Dependencies"
    }
  ],
  "packages": {
    ".": {
      "package-name": "tracarbon",
      "extra-files": [
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value=='tracarbon')].version"
        },
        {
          "type": "yaml",
          "path": "helm/tracarbon/Chart.yaml",
          "jsonpath": "$.appVersion"
        }
      ]
    }
  }
}
